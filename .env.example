ANTHROPIC_API_KEY=your-api-key-here

# Optional settings: remove the leading # to use one.
# MODEL=sonnet             # haiku, sonnet (the default), or opus
# SESSION_BUDGET_USD=1.00  # spending cap for one conversation, in dollars
# APP_PORT=8000            # the next free port is used if this one is busy
# GROUNDING_JUDGE=on       # on (default): a small model also checks every answer against the manual; off keeps only the free word-level checks
